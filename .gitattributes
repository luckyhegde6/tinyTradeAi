# Force LF line endings for shell scripts and systemd service files
*.sh text eol=lf
*.service text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Binary files
*.jpg binary
*.png binary
*.ico binary
