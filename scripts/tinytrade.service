[Unit]
Description=TinyTrade AI - Edge Market Intelligence Terminal
After=network.target i2c-dev.service
Before=rc-local.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tinyTradeAi
ExecStart=/opt/tinyTradeAi/scripts/startup.sh
Restart=always
RestartSec=15
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=tinytrade

[Install]
WantedBy=multi-user.target
