# TinyTrade AI Environment Variables

# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID. The bot will ONLY respond to this ID (Zero Trust).
TELEGRAM_CHAT_ID=your_chat_id_here

# Orange Pi SSH connection
SSH_HOST=192.168.0.11
SSH_USER=root
SSH_PASS=orangepi
